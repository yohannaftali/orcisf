.env

# vcpkg checkout (per src/README.md's local build instructions, cloned
# at repo root and pointed at via VCPKG_ROOT) and any build dirs created
# outside src/ (src/.gitignore covers build/ output under src/ itself)
vcpkg/
build/
out/
.cache/

# ImGui's persisted window-layout state -- written next to wherever
# orcisf_gui.exe's working directory is when launched (e.g. the repo
# root, if launched from there rather than its own build dir).
imgui.ini